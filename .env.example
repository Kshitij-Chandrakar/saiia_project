ENABLE_SCREEN_VISION_FALLBACK=true
SCREEN_VISION_TIMEOUT_SECONDS=15
SCREEN_VISION_FALLBACK_TIMEOUT_SECONDS=20
SCREEN_VISION_MAX_OUTPUT_TOKENS=1800
SCREEN_VISION_DETAIL=high
SCREEN_VISION_CONFIDENCE_THRESHOLD=0.72
SCREEN_VISION_MAX_IMAGE_WIDTH=1600
ENABLE_LOCAL_OCR_PREPASS=true
ENABLE_LOCAL_OCR_SHORT_CIRCUIT=true
ENABLE_RAPIDOCR_FALLBACK=true
SCREEN_ANALYZE_DEBUG_SAVE=false
SCREEN_FULL_CAPTURE_ENABLED=true
SCREEN_FULL_CAPTURE_MAX_SCROLLS=4
SCREEN_FULL_CAPTURE_SCROLL_AMOUNT=0.75
SCREEN_FULL_CAPTURE_WAIT_MS=250
SCREEN_FULL_CAPTURE_RESTORE_SCROLL=true
