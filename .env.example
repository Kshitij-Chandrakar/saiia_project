SYSTEM_AUDIO_DEBUG_SAVE=false
SYSTEM_AUDIO_GAIN=2.0
SYSTEM_AUDIO_MAX_GAIN=4.0
SCREEN_VISION_PROVIDER=openai
OPENROUTER_API_KEY=
