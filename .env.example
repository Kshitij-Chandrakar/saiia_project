ANSWER_PROVIDER=openai
ANSWER_FALLBACK_PROVIDER=groq
ENABLE_ANSWER_PROVIDER_FALLBACK=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_DEFAULT_REASONING_EFFORT=low
OPENAI_COMPLEX_REASONING_EFFORT=medium
OPENAI_VALIDATION_REASONING_EFFORT=low
OPENAI_CORRECTION_REASONING_EFFORT=low
OPENAI_PRIMARY_TIMEOUT_SECONDS=25
OPENAI_VALIDATION_TIMEOUT_SECONDS=15
OPENAI_CORRECTION_TIMEOUT_SECONDS=20
OPENAI_STANDARD_MAX_OUTPUT_TOKENS=2500
OPENAI_PERSONAL_MAX_OUTPUT_TOKENS=2500
OPENAI_CODING_MAX_OUTPUT_TOKENS=6000
OPENAI_SYSTEM_DESIGN_MAX_OUTPUT_TOKENS=5000
ENABLE_SEMANTIC_VALIDATION=true
ENABLE_CONDITIONAL_CORRECTION=true
ENABLE_ALWAYS_ON_REFINEMENT=false
ENABLE_TRUE_ANSWER_STREAMING=true
ENABLE_CONTROLLED_ANSWER_VARIATION=true
VARIATION_HISTORY_LIMIT=3
VARIATION_CACHE_TTL_SECONDS=7200
ENABLE_VARIATION_REWRITE=true
ENABLE_LIVE_FOLLOWUP_RESOLUTION=true
FOLLOWUP_HISTORY_LIMIT=5
FOLLOWUP_CONTEXT_TTL_SECONDS=1800
ENABLE_FOLLOWUP_INTENT_COMPILER=true
ENABLE_MODEL_ASSISTED_FOLLOWUP_RESOLUTION=false
LLM_PROVIDER=openai
PRIMARY_LLM_PROVIDER=openai
STT_PROVIDER=assemblyai
MANUAL_STT_PROVIDER=groq
STT_FALLBACK_PROVIDER=whisper_local
