{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"set ELECTRON_RUN_AS_NODE=&& electron . --trace-warnings\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^23.6.0",
    "eslint": "^9.30.1",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0"
  }
}
